{
  "name": "@yesiree/htmlc",
  "version": "0.0.18",
  "description": "A simple tool for compiling HTML files",
  "type": "module",
  "files": [
    "./lib/cli.js",
    "./lib/commands.js",
    "./lib/compile-css.js",
    "./lib/compile-html.js",
    "./lib/compile-img.js",
    "./lib/compile-js.js",
    "./lib/index.js",
    "./lib/logging.js",
    "./lib/params.js",
    "./lib/utils.js"
  ],
  "main": "./lib/index.js",
  "bin": "./lib/cli.js",
  "scripts": {
    "test-watch": "node lib/cli.js -m -c -w --src test/src/ --out .ignore/dest/",
    "example": "node lib/cli.js --no-compress --copy **/*.txt --src test/src/ --out .ignore/dest/",
    "compare": "node test/equals.js .ignore/dest/index.html test/expected.html"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yesiree/htmlc.git"
  },
  "keywords": [
    "html",
    "compile",
    "minify",
    "css",
    "sass",
    "scss",
    "style",
    "script",
    "javascript",
    "js"
  ],
  "author": "Trevor Reed",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/yesiree/htmlc/issues"
  },
  "homepage": "https://github.com/yesiree/htmlc#readme",
  "dependencies": {
    "chalk": "^5.3.0",
    "chokidar": "^4.0.1",
    "diff": "^7.0.0",
    "fast-glob": "^3.3.2",
    "html-minifier-terser": "^7.2.0",
    "js-beautify": "^1.15.1",
    "jsdom": "^25.0.1",
    "minimist": "^1.2.8",
    "mkdirp": "^3.0.1",
    "nunjucks": "^3.2.4",
    "sass": "^1.81.0",
    "sharp": "^0.33.5",
    "terser": "^5.36.0"
  },
  "devDependencies": {
    "colors": "^1.4.0"
  }
}
